{
  "name": "form-picker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "dev2": "concurrently \"json-server ./jsonserver/db.json --port 8080 --routes ./jsonserver/routes.json\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "prod": "vite build && vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "fix": "npm run lint:fix && npm run format:fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.99.0",
    "start-dom-jsx": "1.0.0-beta.1",
    "tailwindcss": "^4.2.2",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.0.8"
  }
}
