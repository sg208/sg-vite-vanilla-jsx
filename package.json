{
  "name": "form-picker",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "author": "Syailendra Ginting",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev2": "concurrently \"json-server ./jsonserver/db.json --port 8080 --routes ./jsonserver/routes.json\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "prod": "vite build && vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.107.1",
    "start-dom-jsx": "1.0.0-beta.1",
    "tailwindcss": "^4.3.3",
    "unplugin-auto-import": "21.1.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
